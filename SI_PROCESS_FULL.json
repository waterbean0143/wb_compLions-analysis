{
  "1_SI_Methodology_Overview": {
    "project_management": {
      "purpose": "대외 SI 사업의 체계적인 사업관리를 통한 성공률 향상",
      "scope": "영업기회식별부터 종료까지 생명주기 전 단계 적용. 프로젝트의 규모, 특성에 따라 방법론 테일러링 적용",
      "references": [
        "ISO9001",
        "CMMI",
        "PM Bok",
        "L-OSSP (사내 OSSP)"
      ],
      "main_contents": [
        "제안/계약",
        "착수/계획",
        "실행/통제",
        "종료/사후관리",
        "R&R 정의",
        "산출물 정의",
        "절차 기반 프로젝트 관리"
      ],
      "strength": "공공 및 대외 SI 사업 중심의 사업관리 활동을 실제 현업 용어 및 흐름에 맞게 설명",
      "target_roles": [
        "영업대표",
        "BD",
        "PM/PL",
        "사업관리자",
        "프로젝트 QA"
      ]
    },
    "software_development": {
      "purpose": "대외 SI 사업의 표준화된 SW개발 통한 개발생산성 및 품질 향상",
      "scope": "SW개발 요구사항분석부터 전개까지 전 단계 적용. 규모와 일정에 따라 유연한 테일러링 가능",
      "references": [
        "ISO/IEC12207",
        "CMMI",
        "정보공학기법 (IE)",
        "CBD 방법론"
      ],
      "main_contents": [
        "요구사항분석",
        "설계",
        "구현",
        "테스트",
        "전개",
        "단계별 개발 산출물 정의",
        "품질 점검 및 이관 프로세스"
      ],
      "strength": "대규모 개발 프로젝트에 적용 가능한 정보공학/CBD 기반 실무 중심 방법론 설명",
      "target_roles": [
        "개발 PL",
        "개발자",
        "아키텍트",
        "프로젝트 QA",
        "테스터"
      ]
    }
  },
  "2_RnR_Definitions": [
    {
      "role": "고객",
      "subrole": "사업주관책임자",
      "activities": [
        "프로젝트에 대한 총괄적인 관리 및 책임을 지는 고객 조직",
        "사업계획 및 프로젝트 표준, 프로젝트 산출물에 대한 승인",
        "개발될 시스템의 요구사항을 제공하고 이를 최종적으로 검증할 책임을 가짐",
        "시스템 개발 결과에 직접적으로 영향을 받는 모든 이해관계자들을 대표함",
        "업무별 위험 식별 및 영향도 평가, 대응방안 수립, 위험 모니터링 및 통제하는 관리 업무를 이행"
      ],
      "department": "발주사(고객사)"
    }
  ],
